# ============================================================
# SESPORT — Environment Variables Template
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring
# ============================================================

# ---- Django ----
SECRET_KEY=your-very-secret-django-key-change-this-in-production
DEBUG=False

# ---- Seed Mode ─────────────────────────────────────────────
# python manage.py seed     → SEED_MODE'ga qarab ishlaydi
# python manage.py seed --mode real   → majburan real data
# python manage.py seed --mode fake   → majburan fake data
# python manage.py seed --mode real --clear  → avval tozalaydi
SEED_MODE=real
# SEED_MODE=fake

# ---- Database: PostgreSQL (production) ─────────────────────
# Development uchun DATABASE_URL ni comment qiling (SQLite ishlatiladi)
DATABASE_URL=postgresql://sesport_user:sesport_password@db:5432/sesport_db

POSTGRES_DB=sesport_db
POSTGRES_USER=sesport_user
POSTGRES_PASSWORD=sesport_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Redis (FSM Storage) ───────────────────────────────────
REDIS_URL=redis://redis:6379/1
USE_REDIS=true
# Development uchun: USE_REDIS=false

# ---- Telegram Bot ──────────────────────────────────────────
BOT_TOKEN=your_bot_token_from_botfather

# ---- Webhook (Production only) ─────────────────────────────
WEBHOOK_URL=https://yourdomain.com/webhook
WEBHOOK_SECRET=your-webhook-secret-token

# ---- Django Superuser (birinchi run) ───────────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@sesport.uz
DJANGO_SUPERUSER_PASSWORD=change-this-password

# ---- App Settings ──────────────────────────────────────────
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
LOG_LEVEL=INFO
