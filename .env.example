# ============================================================
# SESPORT — Environment Variables Template
#
#   cp .env.example .env
#   nano .env
#
# Bu fayl namuna (git'da saqlanadi) va unda HECH QANDAY haqiqiy
# sir bo'lmasligi kerak. Haqiqiy .env commit qilinmaydi (.gitignore).
#
# ARXITEKTURA: reverse proxy va SSL — tashqi Nginx Proxy Manager (NPM).
# Loyiha ichida nginx yo'q, hech bir servis host'ga port ochmaydi.
# ============================================================

# ---- Django ────────────────────────────────────────────────
# MAJBURIY. Bo'sh yoki shablon qiymat bo'lsa konteyner ishga tushmaydi.
# Yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=False

# Vergul bilan ajratilgan domenlar, SXEMASIZ va PORTSIZ.
# localhost/127.0.0.1 avtomatik qo'shiladi (Docker healthcheck uchun).
#   Misol: ALLOWED_HOSTS=example.com,www.example.com
ALLOWED_HOSTS=

# Admin panelga login qilish uchun MAJBURIY (Django 4+ talabi).
# SXEMA BILAN yoziladi. NPM SSL termination qilgani uchun — https://
#   Misol: CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=

# ---- HTTPS ─────────────────────────────────────────────────
# NPM'da domen uchun SSL sertifikat OLINGANDAN KEYIN true qiling.
# Redirect loop bo'lmaydi: NPM `X-Forwarded-Proto: https` yuboradi.
# NPM Proxy Host'da "Force SSL" ni ham yoqing.
ENABLE_HTTPS=false

# ---- Nginx Proxy Manager ───────────────────────────────────
# NPM konteyneri ulangan Docker network nomi. Aniqlash:
#   docker ps --format '{{.Names}}' | grep -i proxy
#   docker inspect <npm-container> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}'
NPM_NETWORK=npm_network

# NPM Docker'da BO'LMASA (host'ga o'rnatilgan bo'lsa) —
# docker-compose.hostport.yml overlay bilan ishlating.
# Bu port FAQAT 127.0.0.1 ga bog'lanadi, internetga chiqmaydi.
WEB_LOCAL_PORT=2020

# ---- Database: PostgreSQL ──────────────────────────────────
# MAJBURIY. Berilmasa Django production rejimida ishga tushmaydi
# (SQLite'ga jim o'tish qat'iyan taqiqlangan).
#
# TAVSIYA ETILGAN YO'L: quyidagi POSTGRES_* o'zgaruvchilarini to'ldiring
# va DATABASE_URL ni BO'SH qoldiring. Bunda parolda @ : / # kabi
# belgilar bo'lsa ham hech narsani kodlash kerak emas.
#
# Host = `db` (compose servis nomi), localhost/127.0.0.1 EMAS —
# konteyner ichida localhost o'sha konteynerning o'zini bildiradi.
POSTGRES_DB=sesport_db
POSTGRES_USER=sesport_user
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# MUQOBIL YO'L (ixtiyoriy): bitta URL bilan.
# DIQQAT — eng ko'p uchraydigan xato shu yerda:
#   POSTGRES_PASSWORD  -> XOM parol           (masalan:  Pa@ss/1)
#   DATABASE_URL ichi  -> PERCENT-ENCODED     (masalan:  Pa%40ss%2F1)
# Ikkalasi mos kelmasa "password authentication failed" bo'ladi.
# Shuning uchun oddiyroq: DATABASE_URL ni bo'sh qoldiring.
#   @ -> %40    / -> %2F    # -> %23    : -> %3A
DATABASE_URL=

# ---- Redis (aiogram FSM Storage) ───────────────────────────
# Host = `redis` (compose servis nomi)
REDIS_URL=redis://redis:6379/1
USE_REDIS=true

# ---- Telegram Bot ──────────────────────────────────────────
BOT_TOKEN=

# ---- Webhook (ishlatilmaydi — bot long polling rejimida) ────
WEBHOOK_URL=
WEBHOOK_SECRET=

# ---- Django Superuser (birinchi run'da avtomatik yaratiladi) ─
# Mavjud bo'lsa qayta yaratilmaydi va paroli o'zgartirilmaydi.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# ---- Media ─────────────────────────────────────────────────
# Hozircha loyihada birorta FileField/ImageField yo'q — shikoyat
# rasm/ovozlari Telegram `file_id` sifatida saqlanadi. Shu sababli
# /media/ o'chirilgan. FileField qo'shsangiz true qiling.
SERVE_MEDIA_FILES=false

# ---- Seed Mode ─────────────────────────────────────────────
# docker compose exec web python manage.py seed --mode real
SEED_MODE=real

# ---- Runtime ───────────────────────────────────────────────
LOG_LEVEL=INFO
# Gunicorn worker soni. Formula: (CPU yadro x 2) + 1, lekin har bir
# worker ~80-120 MB RAM oladi. 1-2 GB RAM li VPS uchun 3 optimal.
WEB_CONCURRENCY=3
# DB ko'tarilishini kutish limiti (soniya)
DB_WAIT_TIMEOUT=60

# ============================================================
# PORTLAR
#   80 / 443  -> Nginx Proxy Manager (loyihaga tegishli emas)
#   8000      -> Django, faqat Docker internal (publish YO'Q)
#   5432      -> PostgreSQL, faqat Docker internal (publish YO'Q)
#   6379      -> Redis, faqat Docker internal (publish YO'Q)
# ============================================================
